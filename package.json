{
  "name": "benseditor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A GameMaker-style 2D game engine that runs in the browser, scripted in Luau.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:player": "vite build --config vite.player.config.ts && vite build --config vite.player.config.ts --mode python",
    "build:single": "node tools/build-single.mjs",
    "build:docs": "node tools/build-docs.mjs",
    "build": "npm run build:player && tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:vendor && npm run test:fixed-step && npm run test:engine && npm run test:api && npm run test:tree && npm run test:python-smoke && npm run test:engine-py && npm run test:api-py && npm run test:python-syntax && npm run test:blocks && npm run test:templates && npm run test:dash && npm run test:gd-physics && npm run test:gd-codec && npm run test:gd-spawner && npm run test:gd-logic && npm run test:docs && npm run test:dev && npm run test:browser && npm run test:explorer && npm run test:browser-python && npm run test:browser-blocks && npm run test:snake && npm run test:export && npm run test:electron && npm run test:single",
    "test:engine": "node --experimental-wasm-jspi tests/engine.test.mjs",
    "test:docs": "node tests/docs.test.mjs",
    "test:api": "node --experimental-wasm-jspi tests/api.test.mjs",
    "test:tree": "node --experimental-wasm-jspi tests/tree.test.mjs",
    "test:vendor": "node tools/vendor-micropython.mjs --check",
    "test:fixed-step": "node tests/fixed-step.test.mjs",
    "test:python-syntax": "node tests/pythonSyntax.test.mjs",
    "test:python-smoke": "node tests/python-smoke.test.mjs",
    "test:engine-py": "node tests/engine-py.test.mjs",
    "test:api-py": "node tests/api-py.test.mjs",
    "test:browser-python": "node tests/browser-python.test.mjs",
    "test:blocks": "node --experimental-wasm-jspi tests/blocks.test.mjs",
    "test:browser-blocks": "node tests/browser-blocks.test.mjs",
    "test:templates": "node --experimental-wasm-jspi tests/templates.test.mjs",
    "test:dash": "node tests/dash.test.mjs",
    "test:gd-physics": "node --experimental-wasm-jspi tests/gd-physics.test.mjs",
    "test:gd-codec": "node tests/gd-codec.test.mjs",
    "test:gd-spawner": "node tests/gd-spawner.test.mjs",
    "test:gd-logic": "node tests/gd-logic.test.mjs",
    "test:explorer": "node tests/explorer.test.mjs",
    "test:dev": "node tests/dev.test.mjs",
    "test:browser": "npm run build && node tests/browser.test.mjs",
    "test:snake": "node tests/snake.test.mjs",
    "test:export": "node tests/export.test.mjs",
    "test:electron": "node tests/electron.test.mjs",
    "test:single": "npm run build:single && node tests/single.test.mjs"
  },
  "dependencies": {
    "blockly": "13.2.1",
    "luau-web": "^1.4.0"
  },
  "build": {
    "appId": "dev.benseditor.app",
    "productName": "Benseditor",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@micropython/micropython-webassembly-pyscript": "1.28.0-6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
